# Copy to .env next to hub.mjs. Never commit .env.
# Token of THIS machine's bot (from @BotFather). One bot per machine.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram user id: the hub obeys only you.
OWNER_ID=
# One long-lived token per Claude subscription account (run `claude setup-token` while logged in to that account);
# the variable names are whatever config.json agents.<id>.tokenEnv says. Not needed on a machine that just uses its own login.
CLAUDE_A_OAUTH_TOKEN=
CLAUDE_B_OAUTH_TOKEN=
# Optional: created automatically by /approvals on (desktop-app permission prompts → your phone).
# HUB_HOOK_TOKEN=
